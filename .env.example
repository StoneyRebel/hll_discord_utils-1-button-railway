REGISTER_PLAYER_ENABLED=false
COMFORT_FUNCTIONS_ENABLED=false
MAP_ROTATION_ENABLED=false
SERVER_STATUS_ENABLED=false
ARTILLERY_CALCULATOR_ENABLED=false
SERVER_BALANCE_ENABLED=false
AUTO_LEVEL_ENABLED=false

# Map Vote Settings
MAP_VOTE_CHANNEL_ID=
MAP_VOTE_DRYRUN=false
MAP_VOTE_ACTIVATE_VOTE=1
MAP_VOTE_DEACTIVATE_VOTE=0
MAP_VOTE_REMINDER=20
MAP_VOTE_STEALTH_VOTE=false
MAP_VOTE_MAX_REMINDERS=0
MAP_VOTE_HEADER=Vote for the nextmap on <your discord>
MAP_VOTE_DUPLICATE_MAPS=true

# Auto Level Settings
AUTO_LEVEL_DRYRUN=false
AUTO_LEVEL_MIN_LEVEL=50
AUTO_LEVEL_ALLOW_VIPS=true
AUTO_LEVEL_PLAYER_COUNT=60
